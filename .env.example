# ===================================================================
# Crystal Messenger - Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the filled copy to version control.
#
#   cp .env.example .env
# ===================================================================

# Supabase (from dashboard: Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Erlang WebSocket server URL
# For local Docker:  ws://localhost:8081/ws
# For production:    wss://your-server-domain.com/ws
ERLANG_WS_URL=ws://localhost:8081/ws

# Firebase (optional - push notifications)
# If not set, push notifications are disabled gracefully.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-app-id
# FIREBASE_ANDROID_API_KEY=your-android-key
# FIREBASE_IOS_API_KEY=your-ios-key

# Docker port mapping
CRYSTAL_WS_PORT=8081

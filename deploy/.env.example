# ============================================================================
# Crystal Messenger — self-hosted Supabase env.
# Copy to deploy/.env and fill in real secrets, then `docker compose up -d`.
#
#   POSTGRES_PASSWORD   -> openssl rand -base64 32
#   JWT_SECRET          -> openssl rand -base64 64   (>= 32 chars)
#   ANON_KEY / SERVICE_ROLE_KEY -> JWT signed with JWT_SECRET, payload:
#       { "role": "anon" | "service_role", "iss": "supabase", "iat": ..., "exp": ... }
#       (generate with the supabase CLI, or jwt.io against your JWT_SECRET)
# ============================================================================

# --- Postgres ---------------------------------------------------------------
POSTGRES_IMAGE_TAG=15.8.1.169
POSTGRES_PASSWORD=change-me-super-secret
POSTGRES_PORT=5432

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=change-me-64-byte-random-secret
JWT_EXP=3600

# --- Keys (anon + service_role JWTs, see header comment) ----------------------
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Default Supabase sign-in and guest/anonymous sign-in are ENABLED:
AUTH_ENABLED=true
EMAIL_SIGNUP_ENABLED=true
ANONYMOUS_SIGNIN_ENABLED=true
# Dev convenience: confirm emails instantly. In production point MAILER_URLS at
# SMTP (resend/ses/etc.) and set AUTOCONFIRM=false.
EMAIL_AUTOCONFIRM=true
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:5173

# --- Public origin the client + proxy reach ----------------------------------
PUBLIC_ORIGIN=http://localhost:8000
DOMAIN=localhost:8000

# --- Push wiring (spread into DB by deploy/apply.sql) ------------------------
EDGE_RUNTIME_INTERNAL=http://edge-runtime:8081
PUSH_FUNCTION_URL=http://edge-runtime:8081/functions/v1/send-push

# --- Studio ----------------------------------------------------------------
STUDIO_PORT=8000
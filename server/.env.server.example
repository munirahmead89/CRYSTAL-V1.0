# Crystal Messenger real-time server configuration.
# Copy to .env.server and fill in. Never commit the filled copy.

# REQUIRED: Supabase project JWT secret.
# Dashboard -> Settings -> API -> JWT Secret (or `supabase status`).
# Setting this switches the server from DEV TRUST to ENFORCED auth.
SUPABASE_JWT_SECRET=

# Port to listen on (default 8081).
CRYSTAL_WS_PORT=8081

# Max simultaneous connections (default 50000).
# CRYSTAL_WS_MAX_CONN=50000

# Optional: terminate TLS inside the server instead of a proxy.
# CRYSTAL_WS_CERTFILE=/certs/fullchain.pem
# CRYSTAL_WS_KEYFILE=/certs/privkey.pem

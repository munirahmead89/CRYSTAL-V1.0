%% ===================================================================
%% Crystal Messenger - Real-time Server (Erlang/OTP)
%%
%% This is the build recipe. `rebar3` reads this file to know which
%% libraries to download and how to compile the app.
%%
%% Build:  rebar3 compile
%% Run:    rebar3 shell
%% ===================================================================
{erl_opts, [debug_info]}.

{deps, [
    %% Cowboy: the HTTP + WebSocket web server (industry standard, powers
    %% WhatsApp-scale traffic patterns with one lightweight process per
    %% connected phone).
    {cowboy, "2.12.0"},
    %% jsone: converts Erlang terms <-> JSON text (the wire format the
    %% mobile app speaks).
    {jsone, "1.9.0"}
]}.

{shell, [
    {apps, [crystal_server]}
]}.

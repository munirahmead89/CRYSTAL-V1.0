# Copy this file to secrets.env and fill in YOUR project's real values.
# secrets.env is gitignored - never commit real credentials.
# Build with: tools/build_release.ps1  (or flutter build apk --dart-define-from-file=secrets.env)
#
# The anon key is Supabase's PUBLISHABLE key (RLS protects data). NEVER put
# the service_role key or DB password in here or in the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
APP_ENV=production
APP_NAME=Crystal Messenger
APP_LOG_VERBOSITY=info

# --- Optional ---------------------------------------------------------------
# Every key below is read by the app. Leaving one blank is safe: the app falls
# back to a working default and says so at the point of use. They are listed
# because a missing key degrades a feature quietly rather than failing a build.

# HTTPS endpoint returning {"url": "<supabase url>", "anonKey": "<anon key>"}.
# Set this for a real release. When present, the Supabase URL and anon key are
# fetched at runtime and cached in encrypted storage, so they are NOT compiled
# into the APK - which is the whole point of the remote-config design. When
# absent, the two values above are baked into the binary in plain text.
APP_CONFIG_URL=

# Base URL for any non-Supabase HTTP API. Unused today; declared so the key is
# not a surprise if an endpoint is added.
APP_API_BASE_URL=

# --- Calls ------------------------------------------------------------------
# STUN alone connects most calls. It cannot connect through symmetric NAT or
# carrier-grade NAT, which is most corporate, university and hotel wifi: there,
# neither peer is reachable and the call simply never rings. Supplying a TURN
# relay fixes exactly those cases.
#
# Free options: Cloudflare's TURN service, or your own coturn.
#
# TURN_URL is a single endpoint. Use TURN_URLS instead for several,
# comma-separated, matching an ICE server's `urls` list:
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TURN_URLS=
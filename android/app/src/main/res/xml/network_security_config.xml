<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All Crystal traffic goes over HTTPS. Cleartext is denied globally
         (supabase.co and the app-config Edge Function are TLS-only). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
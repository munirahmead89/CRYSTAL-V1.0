# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/app/build/
/android/.gradle/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local build secrets - never commit real Supabase credentials.
secrets.env
android/key.properties
!/secrets.env.example

# Release signing material. The keystore IS the app's identity: whoever holds
# it can ship updates that replace this app on a user's device. It must never
# enter version control, and the passwords in key.properties are the only other
# thing protecting it. Keep an offline backup of both instead.
android/*.jks
android/*.keystore
*.jks
*.keystore
